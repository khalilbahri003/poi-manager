# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
PORT=5000
# Optional: comma-separated permitted browser origins for a separate frontend domain
ALLOWED_ORIGINS=
# Optional: set to 1 only when deployed behind a trusted reverse proxy
TRUST_PROXY=
# Optional: persistent database folder (defaults to server/data)
DATA_DIR=
